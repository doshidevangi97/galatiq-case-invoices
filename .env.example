# Copy this file to .env and add your own key: cp .env.example .env
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model used for extracting .txt/.pdf invoices
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Anthropic key for the critic agent in the approval stage (Claude Opus 5.5).
# Without it the critic falls back to Qwen on Groq.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
